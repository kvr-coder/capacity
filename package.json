{
  "name": "capacity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cross-plant, cross-continent production capacity modeling cockpit",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
